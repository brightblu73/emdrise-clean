{
  "appId": "com.emdrise.app",
  "appName": "EMDRise",
  "webDir": "dist/public",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "backgroundColor": "#1a1a2e",
      "androidSplashResourceName": "splash",
      "iosSplashResourceName": "Splash",
      "showSpinner": false
    },
    "StatusBarPlugin": {}
  },
  "ios": {
    "contentInset": "none",
    "packageClassList": [
      "SignInWithApple",
      "AppPlugin",
      "HapticsPlugin",
      "ScreenOrientationPlugin",
      "SplashScreenPlugin",
      "PurchasesPlugin",
      "SentryCapacitorPlugin",
      "StatusBarPlugin",
      "AppTrackingTransparencyPlugin"
    ]
  },
  "SignInWithApple": {
    "clientId": "com.emdrise.app",
    "redirectURI": "com.emdrise.app://auth/callback"
  }
}
